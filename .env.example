# Copy to .env.local and fill in. Never commit .env.local.
# PUBLIC   = shipped to the browser (NEXT_PUBLIC_ prefix). Safe to expose.
# SERVER   = server-only. Never prefix with NEXT_PUBLIC_, never import in client code.

# --- Supabase (Dashboard > Project Settings > API Keys / Data API) ----------
# PUBLIC: project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# PUBLIC: publishable key (sb_publishable_...). RLS limits what it can do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER: secret key (sb_secret_...). BYPASSES RLS. Used only by webhooks,
# payment verification, order finalisation, refunds, seeding.
SUPABASE_SECRET_KEY=
# SERVER (optional): defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# --- Site ------------------------------------------------------------------
# PUBLIC: base URL used in auth email redirects. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay (Dashboard > Account & Settings > API Keys, test mode) --------
# SERVER: key id (rzp_test_...). The server hands it to the browser at checkout,
# which is expected; it is not a secret, but keep config in one place.
RAZORPAY_KEY_ID=
# SERVER: key secret. Signs/verifies checkout payments and calls the Razorpay API.
RAZORPAY_KEY_SECRET=
# SERVER: the secret you type when creating the webhook in the Razorpay dashboard.
# Optional until you set up the webhook; checkout works without it.
RAZORPAY_WEBHOOK_SECRET=

# --- Cashfree (merchant.cashfree.com > switch to Sandbox/Test > Developers > API Keys)
# SERVER: App ID (also called client id).
CASHFREE_APP_ID=
# SERVER: Secret key. Signs API calls and verifies Cashfree webhooks.
CASHFREE_SECRET_KEY=
# SERVER: "sandbox" while testing, "production" only with live keys.
CASHFREE_ENV=sandbox

# --- Direct UPI (QR code / UPI app link, no gateway) ------------------------
# SERVER: the UPI ID that receives payments, e.g. yourname@okaxis. It appears
# in the QR code customers scan, so it is not a secret.
UPI_VPA=
# SERVER: name shown in the customer's UPI app.
UPI_PAYEE_NAME=Furniture Store
